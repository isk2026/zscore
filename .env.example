# 현재 버전은 키 없이 동작합니다 (yfinance 로 미국·한국 모두 수집).
# 아래는 데이터 소스를 확장할 때 쓸 자리 — 실제 값은 .env 에만 넣고 커밋하지 마세요.

# 미국 재무 보강 (Financial Modeling Prep) — https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# 한국 공시 재무 (OpenDART) — https://opendart.fss.or.kr  인증키 신청 (즉시 발급)
DART_API_KEY=

# 한국투자증권 Open API (KIS) — 실시간 시세용
KIS_APP_KEY=
KIS_APP_SECRET=

# 텔레그램 알림 — Beta Model 과 같은 봇 (stockAlam 봇은 쓰지 않음). CI 는 GitHub Secrets 사용, 여기는 로컬 테스트용
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
